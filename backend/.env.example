# Copiez ce fichier en .env et adaptez les valeurs.

# Supabase (production / dev cloud)
USE_SQLITE=false
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Ou SQLite local uniquement si vous n'utilisez pas Supabase :
# USE_SQLITE=true
# (ne pas définir DATABASE_URL)

# Ou PostgreSQL local / Docker :
# USE_SQLITE=false
# DATABASE_URL=postgresql://seth_user:seth_password@localhost:5432/seth_db

# Sécurité
JWT_SECRET_KEY=dev-jwt-secret
SECRET_KEY=dev-secret-key

# Planificateur de tâches (géofencing) — optionnel en local
ENABLE_SCHEDULER=false

# Dev : pas de blocage après 5 mauvais mots de passe (défaut true en local)
DISABLE_LOGIN_LOCKOUT=true

# Web Push — générer avec: python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# VAPID_CLAIMS_EMAIL=mailto:admin@seth.com

# Si PostgreSQL échoue, basculer automatiquement sur SQLite
# ALLOW_SQLITE_FALLBACK=true
